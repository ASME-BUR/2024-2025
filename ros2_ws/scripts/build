#!/bin/bash

mkdir -p src/dependencies
vcs import --input required.repos src/dependencies

set -o pipefail
let restarts=1
while true; do
    exec 5>&2
    msg=$(colcon build --symlink-install 3>&2 2>&1 1>&3 | tee /dev/fd/5)
    exit_code=$?
    if [ $exit_code -eq "0" ] || ! [[ $msg =~  "Killed signal terminated program cc1plus" ]]; then
        (exit "$exit_code")
        break
    else
        echo -e "\n\e[32m[INFO] \e[34mOOM SIGKILL detected, restarting... (# restarts: $restarts)\e[0m\n"
        let restarts++
    fi
done
