 <root BTCPP_format="4" >
    <BehaviorTree ID="MainTree">
        <SequenceWithMemory>
            <RetryUntilSuccessful num_attempts="6">
                <SequenceWithMemory>
                    <SubTree ID="GateTask"/>
                    <SubTree ID="BuoyTask"/>
                    <SubTree ID="OctagonTask"/>
                </SequenceWithMemory>
            </RetryUntilSuccessful>
        </SequenceWithMemory>
    </BehaviorTree>

    <BehaviorTree ID="GateTask">
        <SequenceWithMemory>
            <Sequence>
                <GoToTarget/>
            </Sequence>
            <BarrelRoll />
            <DriveForward />
        </SequenceWithMemory>
    </BehaviorTree>

    <BehaviorTree ID="BuoyTask">
        <SequenceWithMemory>
            <Sequence>
                <GoToTarget/>
            </Sequence>
            <FireTorpedo/>
        </SequenceWithMemory>
    </BehaviorTree>

    <BehaviorTree ID="OctagonTask">
        <SequenceWithMemory>
            <Sequence>
                <GoToTarget/>
            </Sequence>
        </SequenceWithMemory>
    </BehaviorTree>
 </root>
